# Copy to .env.local and fill in. Never commit the filled version.
# Every stage falls back to its getMock* path when its key is missing,
# so the app runs end to end with this file completely empty.

# OpenAI — creative director (concepts, and the one-off GLiNER2 labelling run)
OPENAI_API_KEY=

# fal — LoRA training + keyframe gen + Kling i2v. Promo: techeuropexfal-london
FAL_KEY=

# Tavily — Extract (page text + product images) and Search (reviews). Promo: AugustLondon
TAVILY_API_KEY=

# Pioneer / Fastino — GLiNER2 fine-tune + inference
PIONEER_API_KEY=
