# Copy to .env.local and fill in. Never commit the filled version.
# Every stage falls back to its getMock* path when its key is missing,
# so the app runs end to end with this file completely empty.

# OpenAI — creative director (concepts, and the one-off GLiNER2 labelling run)
OPENAI_API_KEY=

# fal — LoRA training + keyframe gen + Kling i2v. Promo: techeuropexfal-london
FAL_KEY=

# Tavily — Extract (page text + product images) and Search (reviews). Promo: AugustLondon
TAVILY_API_KEY=

# Pioneer / Fastino — GLiNER2 fine-tune + inference
PIONEER_API_KEY=

# Clerk — `clerk init` writes these into .env.local. Do not copy secrets around.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/

# Convex — `npx convex dev` writes CONVEX_DEPLOYMENT + NEXT_PUBLIC_CONVEX_URL.
# Clerk JWT issuer (Frontend API URL) must also be set on the Convex deployment:
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN=https://<instance>.clerk.accounts.dev
# And in the Clerk Dashboard, enable the Convex integration (JWT template `convex`).
